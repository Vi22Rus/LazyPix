<Application x:Class="WoWForeverAssistant.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#071321"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0C1D31"/>
    <SolidColorBrush x:Key="CardAltBrush" Color="#122A46"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#E9C17B"/>
    <SolidColorBrush x:Key="SoftTextBrush" Color="#A7B8CB"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F5F9"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F0D5A1"/><Setter Property="Background" Value="#173251"/>
      <Setter Property="BorderBrush" Value="#476383"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#285785"/><Setter TargetName="Bd" Property="BorderBrush" Value="#67BAFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#081727"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3C5773"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="White"/></Style>
    <!-- Explicit WPF ComboBox template: prevents the default Windows white selection box and blue highlight. -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F5F7FA"/>
      <Setter Property="Background" Value="#142E49"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemBackground" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#285785"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#1B456C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsHighlighted" Value="True"/><Condition Property="IsSelected" Value="True"/></MultiTrigger.Conditions><Setter TargetName="ItemBackground" Property="Background" Value="#285785"/></MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#142E49"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#476383"/>
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"/></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
            <ContentPresenter Margin="12,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" TextElement.Foreground="#FFFFFF"/>
            <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#E9C17B" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" IsHitTestVisible="False"/>
            <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0" Focusable="False"
                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
              <Border Background="#142E49" BorderBrush="#6386A7" BorderThickness="1" CornerRadius="6" MinWidth="320" MaxHeight="260">
                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#67BAFF"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#102A46"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#E9C17B"/><Setter Property="Padding" Value="9,6"/></Style>
  </Application.Resources>
</Application>
