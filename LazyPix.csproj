<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LazyPix</AssemblyName>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets\LazyPix.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="WoWForeverAssistant.Localization.%(Filename)%(Extension)" />
    <Resource Include="Assets\LazyPix.png" />
    <Resource Include="Assets\LazyPix.ico" />
    <Resource Include="Assets\*.jpg" />
    <Resource Include="Assets\flag_*.png" />
    <Resource Include="Assets\SpecIcons\*.png" />
    <EmbeddedResource Include="Data\spells_ru_en.json" LogicalName="WoWForeverAssistant.Data.spells_ru_en.json" />
    <Resource Include="Assets\SpellIcons\*.png" />

  </ItemGroup>
</Project>
